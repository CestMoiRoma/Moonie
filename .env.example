# ── Discord ───────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Optional: primary guild id. If set, slash commands sync instantly to this guild
# instead of waiting up to an hour for global propagation. Great for development.
GUILD_ID=

# Prefix for legacy text commands (slash commands are preferred).
PREFIX=-

# ── Web dashboard / API ─────────────────────────────────────────────────────────
# Address uvicorn binds to. Keep on the LAN — the dashboard is UNAUTHENTICATED
# until Phase 4. Use 127.0.0.1 for local-only, 0.0.0.0 to reach it from the LAN.
BIND_ADDR=0.0.0.0
BIND_PORT=8080

# ── Database ────────────────────────────────────────────────────────────────────
# SQLite file (async via aiosqlite). Lives on a mounted volume in Docker.
DATABASE_URL=sqlite+aiosqlite:///./data/moonie.db

# ── Misc ─────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
